DATABASE_URL=postgres://postgres:postgres@localhost:5432/gorosei
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gorosei_test
RIOT_API_KEY=RGAPI-your-development-key
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REALTIME_PORT=3001
# The websocket server listens here; the reverse proxy must forward /realtime to it (Vite does it in dev).
# Notification email through Resend (https://resend.com). Without a key, emails are only logged.
# EMAIL_FROM is required when RESEND_API_KEY is set, e.g. "Gorosei <avisos@tu-dominio>".
RESEND_API_KEY=
EMAIL_FROM=
# Riot-approved capabilities, each switched on alone once Riot grants it. Empty = the fallback paths only.
# RIOT_FEATURES=rso,tournament_codes,result_callbacks
RIOT_FEATURES=
# Riot Sign On client (required with rso).
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
# "true" uses the tournament-stub API (development keys); "false" the real tournament API.
RIOT_TOURNAMENT_STUB=false
# Path secret for the Riot result callback URL, at least 32 characters (required with result_callbacks).
RIOT_CALLBACK_SECRET=
